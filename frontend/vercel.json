{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/proyectos", "destination": "/content-hub/index.html", "permanent": true },
    { "source": "/proyectos/", "destination": "/content-hub/index.html", "permanent": true }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "http://187.124.234.72/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
