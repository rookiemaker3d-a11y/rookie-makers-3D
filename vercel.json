{
  "installCommand": "cd Content-Hub && npx --yes pnpm@9 install --ignore-scripts && cd ../frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    { "source": "/proyectos", "destination": "/content-hub/index.html", "permanent": true },
    { "source": "/proyectos/", "destination": "/content-hub/index.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/content-hub", "destination": "/content-hub/index.html" },
    { "source": "/content-hub/", "destination": "/content-hub/index.html" },
    { "source": "/content-hub/:path*", "destination": "/content-hub/:path*" },
    { "source": "/api/:path*", "destination": "http://187.124.234.72/api/:path*" },
    { "source": "/((?!api/|assets/|content-hub/|logos/).*)", "destination": "/index.html" }
  ]
}
