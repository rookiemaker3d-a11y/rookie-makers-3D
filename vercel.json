{
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/deploy-dist",
  "rewrites": [
    { "source": "/app/assets/:path*", "destination": "/app/assets/:path*" },
    { "source": "/app/logos/:path*", "destination": "/app/logos/:path*" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/api/:path*", "destination": "https://api.rookiemakers3d.com/api/:path*" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/logos/:path*", "destination": "/logos/:path*" },
    { "source": "/((?!app/).*)", "destination": "/index.html" }
  ]
}
