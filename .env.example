# Copia a .env y ajusta valores. En el VPS: cp .env.example .env y edita.

# Base de datos (usuario rookie, base rookie_erp - el compose crea el contenedor db)
POSTGRES_PASSWORD=cambiar-en-produccion

# Backend (JWT, sesiones)
SECRET_KEY=cambiar-secret-en-produccion-min-32-chars

# CORS: permitir el dominio del front (o * para cualquiera)
# Ejemplo: https://tu-dominio.com o *
CORS_ORIGINS=*

# URL pública del frontend (se usa en enlaces de correo)
APP_BASE_URL=https://www.rookiemakers3d.com
# Opcional: correo del admin para avisos de pago/suscripción (si vacío = SMTP_USER)
ADMIN_NOTIFY_EMAIL=

# Gmail SMTP (usar App Password de 16 chars, NO tu contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rookiemaker3d@gmail.com
SMTP_PASSWORD=CAMBIAR_APP_PASSWORD_GMAIL
EMAIL_FROM=rookiemaker3d@gmail.com

# WhatsApp Cloud API (Meta). Webhook: /api/whatsapp/webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALERT_TO=
# Opcional: firma X-Hub-Signature-256 (App Secret en Meta)
WHATSAPP_APP_SECRET=

# Mercado Pago (producción: credenciales de la cuenta de MP, NO las de prueba)
# Access Token: panel MP → Tu integración → Credenciales de producción
MP_ACCESS_TOKEN=
# Opcional: si configuras validación de firma en tu integración
MP_WEBHOOK_SECRET=
# URLs de retorno tras pagar (opcional; el webhook es lo que confirma el pago)
MP_SUCCESS_URL=https://www.rookiemakers3d.com/app/perfiles
MP_FAILURE_URL=https://www.rookiemakers3d.com/app/perfiles
MP_PENDING_URL=https://www.rookiemakers3d.com/app/perfiles
# Webhook en el panel de MP (misma URL en prueba y prod, cambia el token):
#   POST https://TU_DOMINIO/api/suscripciones/webhook/mercadopago
# Eventos: pagos (payment). El backend consulta el pago con el token y actualiza suscripción/horas.

# Ollama (en Docker Compose el backend usa http://ollama:11434 vía variable del compose)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=cambiar-n8n-encryption-key-32-chars-minimo
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-n8n-password
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Mexico_City
