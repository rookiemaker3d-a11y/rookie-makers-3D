      "position": [940, 140]
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all()[0]?.json || [];\nconst limited = products.slice(0, 5);\nlet msg = 'Estos son algunos de nuestros productos disponibles:\\n\\n';\nfor (const p of limited) {\n  msg += `- ${p.descripcion}: $${p.costo_final?.toFixed(2) || '0.00'} MXN\\n`;\n}\nmsg += '\\nPara cotizar algo personalizado, escribe *cotizar*.';\nreturn [{ json: { replyText: msg } }];"
      },
      "id": "code-format-products",
      "name": "Formatear productos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body?.toLowerCase() }}",
              "rightValue": "cotizar",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-asks-quote",
      "name": "Pide cotizar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [700, 340]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { replyText: 'Para cotizar, necesito saber:\\n1. Tipo de pieza o descripción\\n2. Material aproximado (PLA, PETG, etc.)\\n3. Ciudad de envío\\n4. Si tienes archivo 3D (STL/OBJ), adjúntalo por WhatsApp o sube tu diseño a nuestra app:\\nhttps://www.rookiemakers3d.com/app/cotizador' } }];"
      },
      "id": "code-cotizar-reply",
      "name": "Respuesta cotizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 340]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { replyText: 'Hola! Soy el asistente de Rookie Makers 3D. Puedo ayudarte con:\\n- Escribe *productos* para ver disponibles\\n- Escribe *cotizar* para una cotización personalizada\\n- Visita nuestra web: https://www.rookiemakers3d.com' } }];"
      },
      "id": "code-default-reply",
